# Supabase project (local: values printed by `npx supabase start`)
NEXT_PUBLIC_SUPABASE_URL="http://127.0.0.1:54321"
NEXT_PUBLIC_SUPABASE_ANON_KEY="replace-with-anon-or-publishable-key"

# Public origin of this app (used for auth email redirects)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Server-only secrets — never prefix with NEXT_PUBLIC_. Not used by the app until Sprint 3
# (document pipeline). Keep it out of the browser bundle and out of git.
# SUPABASE_SERVICE_ROLE_KEY=""

# Feature flags (Update Pack 1.1): "on" enables; anything else hides the feature.
NEXT_PUBLIC_FLAG_DISCOVERY="on"
NEXT_PUBLIC_FLAG_COUPLES="on"
NEXT_PUBLIC_FLAG_ALERTS="on"
NEXT_PUBLIC_FLAG_FIND_A_PRO="on"
# Master Blueprint v2.0
NEXT_PUBLIC_FLAG_NATIONWIDE="on"
NEXT_PUBLIC_FLAG_MY_PROPERTY="on"
NEXT_PUBLIC_FLAG_HOMEOWNER_CLAIMS="on"
NEXT_PUBLIC_FLAG_BUYER_ENQUIRIES="on"
NEXT_PUBLIC_FLAG_VISION="on"
NEXT_PUBLIC_FLAG_MATTERPORT="on"
NEXT_PUBLIC_FLAG_DUTY_PRESETS="on"
# Real image provider for SitePilot Vision stays off until one is chosen (mock provider otherwise).
NEXT_PUBLIC_FLAG_VISION_REAL_PROVIDER="off"

# RLS integration tests (plain PostgreSQL, see README → Testing)
TEST_DATABASE_URL="postgresql://postgres:postgres@localhost:5432/sitepilot_test"

# Claim evidence storage. "local" writes to .local-storage/ for development and CI only
# (no Storage service locally). Leave unset in deployed environments to use Supabase Storage.
STORAGE_DRIVER="local"
