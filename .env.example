# Supabase project (local: values printed by `npx supabase start`)
NEXT_PUBLIC_SUPABASE_URL="http://127.0.0.1:54321"
NEXT_PUBLIC_SUPABASE_ANON_KEY="replace-with-anon-or-publishable-key"

# Public origin of this app (used for auth email redirects)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Server-only secrets — never prefix with NEXT_PUBLIC_. Not used by the app until Sprint 3
# (document pipeline). Keep it out of the browser bundle and out of git.
# SUPABASE_SERVICE_ROLE_KEY=""

# Feature flags (Update Pack 1.1): "on" enables; anything else hides the feature.
NEXT_PUBLIC_FLAG_DISCOVERY="on"
NEXT_PUBLIC_FLAG_COUPLES="on"
NEXT_PUBLIC_FLAG_ALERTS="on"
NEXT_PUBLIC_FLAG_FIND_A_PRO="on"

# RLS integration tests (plain PostgreSQL, see README → Testing)
TEST_DATABASE_URL="postgresql://postgres:postgres@localhost:5432/sitepilot_test"
