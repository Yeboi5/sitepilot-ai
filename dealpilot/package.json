{
  "name": "dealpilot",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:db": "bash scripts/test-migrations.sh",
    "check": "npm run typecheck && npm test && npm run build",
    "test:e2e": "node tests/e2e/journeys.e2e.mjs",
    "db:seed": "tsx scripts/gen-seed-sql.ts",
    "test:integration": "vitest run -c vitest.integration.config.ts",
    "supabase:start": "supabase start -x studio,edge-runtime,logflare,vector,realtime,imgproxy,supavisor,postgres-meta"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.8.0",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.118.0",
    "lucide-react": "^0.460.0",
    "next": "^15.5.28",
    "nodemailer": "^7.0.13",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "server-only": "^0.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.6.2",
    "postcss": "^8.5.32",
    "supabase": "^2.122.1",
    "tailwindcss": "^3.4.19",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
