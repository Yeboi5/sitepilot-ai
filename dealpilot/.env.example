# ─── DealPilot environment template ─────────────────────────────────────────
# Copy to .env.local. Never commit real secrets. Anything without NEXT_PUBLIC_
# stays on the server.

# ── Data & auth ────────────────────────────────────────────────────────────
# "memory" = seeded in-memory demo (no setup, resets on restart).
# "supabase" = real persistence + Supabase Auth (email verification, MFA).
DATA_DRIVER="memory"
# Demo controls (one-click demo sign-in, simulation buttons). Always on for memory.
# Set to "true" ONLY in a demo/staging Supabase project loaded with supabase/seed.sql.
DEMO_MODE="false"
# Roles that must enrol two-step verification (Supabase driver).
MFA_REQUIRED_ROLES="admin"
# Signing secret for memory-driver demo sessions (32+ random chars).
SESSION_SECRET="dev-only-change-me-dev-only-change-me-0000"

# ── Supabase (DATA_DRIVER=supabase). Local values: `npm run supabase:start` ──
NEXT_PUBLIC_SUPABASE_URL="http://127.0.0.1:54321"
NEXT_PUBLIC_SUPABASE_ANON_KEY="replace-with-anon-or-publishable-key"
# Server-only. Bypasses RLS; the service layer enforces authorisation.
# SUPABASE_SERVICE_ROLE_KEY=""
# Public origin, used in email confirmation links.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ── Market ─────────────────────────────────────────────────────────────────
# AU (launch market), NZ or GB. Drives currency, tax and regulator notes.
MARKET="AU"

# ── Revenue ────────────────────────────────────────────────────────────────
# Success fee per completed, verified, qualifying saving (cents). Capped at the saving.
SUCCESS_FEE_CENTS="150"
# Payments stay disabled in Phase 2. Do not set a provider without written approval.
PAYMENTS_PROVIDER="none"

# ── AI ─────────────────────────────────────────────────────────────────────
# "mock" (offline) or "anthropic". Users must consent before their data is sent.
AI_PROVIDER="mock"
# ANTHROPIC_API_KEY=""
AI_MODEL="claude-opus-5-5"

# ── Uploads: malware scanning ──────────────────────────────────────────────
# ClamAV daemon (clamd). Required in production; uploads are refused without it.
# CLAMD_HOST="127.0.0.1"
# CLAMD_PORT="3310"
# Override the production rule (true/false). Leave unset normally.
# UPLOAD_ANTIVIRUS_REQUIRED=""

# ── Email notifications (optional; in-app only without it) ────────────────
# Any SMTP provider. Local Supabase Mailpit: smtp://127.0.0.1:54325
# SMTP_URL="smtps://user:password@smtp.example.com:465"
# EMAIL_FROM="DealPilot <no-reply@yourdomain.com.au>"

# ── External data ──────────────────────────────────────────────────────────
# ABN Lookup web services GUID (free: https://abr.business.gov.au/Tools/WebServices)
# ABR_GUID=""
# Energy Made Easy retailer brands to compare (CDR brand slugs).
# CDR_ENERGY_BRANDS="agl,origin,energyaustralia,red-energy,alinta"
# CDR energy prices are treated as GST-exclusive; set "true" if confirmed otherwise.
# CDR_PRICES_INCLUDE_GST="false"
