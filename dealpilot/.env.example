# ─── DealPilot environment template ─────────────────────────────────────────
# Copy to .env.local. Never commit real secrets. Anything without NEXT_PUBLIC_
# stays on the server.

# Data driver: "memory" (default, seeded demo data, no setup) or "supabase".
DATA_DRIVER="memory"

# Session signing secret for the demo auth driver (32+ random chars).
# Required in production. Generate: openssl rand -base64 48
SESSION_SECRET="dev-only-change-me-dev-only-change-me-0000"

# Supabase (used when DATA_DRIVER=supabase; schema in supabase/migrations)
NEXT_PUBLIC_SUPABASE_URL="http://127.0.0.1:54321"
NEXT_PUBLIC_SUPABASE_ANON_KEY="replace-with-anon-key"
# Server-only. Never expose to the browser.
# SUPABASE_SERVICE_ROLE_KEY=""

# AI provider: "mock" (deterministic, free, default) or "anthropic".
AI_PROVIDER="mock"
# Server-only. Only read inside src/lib/ai/anthropic-provider.ts.
# ANTHROPIC_API_KEY=""
AI_MODEL="claude-opus-5-5"

# Revenue model: fee per verified, completed saving, in cents (AUD).
SUCCESS_FEE_CENTS="150"
FEE_CURRENCY="AUD"
